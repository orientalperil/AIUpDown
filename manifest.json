{
  "manifest_version": 3,
  "name": "AIUpDown",
  "version": "1.10",
  "description": "Option+Up / Option+Down to jump between your prompts on Claude, plus a floating prompt menu with up/down buttons.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{725a03e6-9738-43a4-9e90-ecf639e8468c}"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
